# copier ce fichier en .env avant de lancer docker compose

# base de donnees
DB_HOST=db
DB_PORT=3306
DB_NAME=nrv
DB_USER=nrv
DB_PASSWORD=nrv
DB_ROOT_PASSWORD=root

# ports ouverts sur la machine (a changer si deja pris, ex. sur docketu)
API_PORT=8080
FRONT_PORT=8081
ADMINER_PORT=8082
DB_PORT_HOTE=3307

# api
# dev : affiche le detail des erreurs | prod : le cache (a mettre sur docketu)
APP_ENV=dev
# au moins 32 caracteres (exige par php-jwt 7 pour le hs256)
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire
JWT_TTL=3600
# adresses du front autorisees a appeler l'api, separees par des virgules
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
