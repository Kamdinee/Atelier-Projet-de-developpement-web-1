<?xml version="1.0" encoding="UTF-8"?>
<!-- tests unitaires sans base de donnees : domaine, cas d'usage, securite de l'adaptateur http -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="domaine">
            <directory>tests/Domain</directory>
        </testsuite>
        <testsuite name="cas-usage">
            <directory>tests/Application</directory>
        </testsuite>
        <testsuite name="infrastructure">
            <directory>tests/Infrastructure</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src/Domain</directory>
            <directory>src/Application</directory>
        </include>
    </source>
</phpunit>
